---
import { clothingCollections } from "../data/store";
interface Props {
  collection: (typeof clothingCollections)[number];
}
const { collection } = Astro.props;
---

<section id={collection.id} class="clothing-collection" aria-labelledby={`${collection.id}-title`}>
  <div class="collection-intro">
    <div>
      <h3 id={`${collection.id}-title`}>{collection.title}</h3>
      <p>{collection.model} · Black</p>
    </div>
    <p class="availability">All designs sold out</p>
  </div>
  <div class="clothing-grid">
    {collection.items.map((item) => <article class="clothing-item">
      <a href={item.image} target="_blank" rel="noopener noreferrer" aria-label={`View ${item.name} image full size`}>
        <img src={item.image} alt={item.imageAlt} width="1500" height="1500" loading="lazy" />
      </a>
      <p class="sold-out">Sold out</p>
      <h4>{item.name}</h4>
      <p class="view-label">Back design</p>
    </article>)}
  </div>
  {collection.id === "shirts" && <details class="front-view">
    <summary>View T-shirt front</summary>
    <img src="/assets/store/t-shirt-front.jpeg" alt="Front of a black K9 Global Rescue T-shirt with a small gold logo on the left chest." width="1500" height="1500" loading="lazy" />
  </details>}
</section>

<style>
  .clothing-collection { padding-bottom: 52px; scroll-margin-top: 130px; }
  .collection-intro { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; border-top: 1px solid var(--color-border); padding-top: 28px; }
  h3 { font-size: 1.8rem; margin-bottom: 8px; }
  .collection-intro p { margin: 0; color: var(--color-ink-soft); }
  .availability { font-size: .9rem; }
  .clothing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 24px; }
  .clothing-item img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; background: #f5f5f5; }
  .sold-out { display: inline-block; margin: 16px 0 12px; padding: 4px 10px; border: 1px solid var(--color-border); color: var(--color-gold); font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  h4 { font-size: 1.1rem; line-height: 1.4; margin: 0 0 6px; }
  .view-label { color: var(--color-ink-soft); font-size: .85rem; margin: 0; }
  .front-view { margin-top: 24px; }
  summary { cursor: pointer; color: var(--color-gold); padding-block: 12px; width: fit-content; }
  .front-view img { display: block; width: min(100%, 380px); height: auto; margin-top: 12px; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 5px; }
  @media (max-width: 900px) { .clothing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) {
    .clothing-grid { grid-template-columns: 1fr; }
    .collection-intro { flex-direction: column; align-items: flex-start; }
  }
</style>
