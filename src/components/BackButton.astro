---
interface Props {
  href: string;
  label?: string;
}

const { href, label = "← Back" } = Astro.props;
---

<div class="back-utility">
  <div class="container">
    <a href={href}>{label}</a>
  </div>
</div>

<style>
  .back-utility {
    background: var(--color-offblack);
    border-bottom: 1px solid rgba(232, 180, 72, 0.22);
    padding: 0.85rem 0;
  }

  .back-utility a {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.86rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .back-utility a:hover,
  .back-utility a:focus-visible {
    color: var(--color-gold);
  }
</style>
