---
import Layout from "../components/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BackButton from "../components/BackButton.astro";
---

<Layout title="Contact" description="Contact K9 Global Rescue for general questions, donation questions, partnership inquiries, media inquiries, rescue-related inquiries, and other non-volunteer communication.">
  <BackButton href="/" />

  <Hero
    eyebrow="Contact"
    title="Send A General Inquiry."
    text="Use the contact form or email info@k9globalrescue.org for questions, donation, partnership, media, rescue-related, and other non-volunteer communication."
    primaryLabel="Use Contact Form"
    primaryHref="#contact-form"
    secondaryLabel="Volunteer"
    secondaryHref="/volunteer/"
  />

  <section class="section" id="contact-form">
    <div class="container split">
      <div>
        <SectionHeading
          eyebrow="General contact"
          title="Questions And Inquiries."
          text="This form is for general communication, donation questions, partnership inquiries, media requests, rescue-related inquiries, and other non-volunteer messages. You can also email info@k9globalrescue.org."
        />
        <ul class="check-list">
          <li>General questions.</li>
          <li>Donation questions.</li>
          <li>Partnership, media, or rescue-related inquiries.</li>
          <li>Other non-volunteer communication.</li>
        </ul>
        <p class="contact-note">General inquiries: <a href="mailto:info@k9globalrescue.org">info@k9globalrescue.org</a></p>
        <p class="contact-note">Interested in volunteering? Visit the <a href="/volunteer/">Volunteer page</a> to complete the official intake form.</p>
      </div>
      <form class="panel text-panel form-grid" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <label class="field bot-field">
          Do not fill this out if you are human
          <input name="bot-field" autocomplete="off" tabindex="-1" />
        </label>
        <label class="field">
          Name
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label class="field">
          Email
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label class="field">
          Phone <span>optional</span>
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
        <label class="field">
          Inquiry type
          <select name="inquiry_type" required>
            <option value="">Select one</option>
            <option>General Question</option>
            <option>Donation Question</option>
            <option>Partnership Inquiry</option>
            <option>Media Inquiry</option>
            <option>Rescue Inquiry</option>
            <option>Other</option>
          </select>
        </label>
        <label class="field">
          Message
          <textarea name="message" required></textarea>
        </label>
        <button class="button primary" type="submit">Send inquiry</button>
      </form>
    </div>
  </section>

  <section class="section legal-disclosure" aria-label="Organization and domain information">
    <div class="container">
      <aside class="panel organization-notice">
        <p>
          K9 Global Rescue (K9GR) is a registered 501(c)(3) nonprofit organization. K9 Global Rescue owns and operates both
          <a href="https://k9globalrescue.org">k9globalrescue.org</a> and <a href="https://k9gr.org">k9gr.org</a> as official organizational domains.
          <a href="https://k9gr.org">K9GR.org</a> serves as our primary Google Workspace and organizational email domain. Both domains belong to and are operated by the same nonprofit organization.
        </p>
        <h2>Key Organization Details</h2>
        <dl class="organization-details">
          <div>
            <dt>Legal Name</dt>
            <dd>K9 Global Rescue</dd>
          </div>
          <div>
            <dt>EIN / Federal Charity ID</dt>
            <dd>82-1614707</dd>
          </div>
          <div>
            <dt>Bridge ID</dt>
            <dd>3108588923 (on <a href="https://www.charitynavigator.org/ein/821614707" target="_blank" rel="noopener noreferrer">Charity Navigator</a>)</dd>
          </div>
          <div>
            <dt>IRS Classification</dt>
            <dd>501(c)(3) tax-exempt public charity (issued December 2017)</dd>
          </div>
          <div>
            <dt>Headquarters</dt>
            <dd>7917 E Mexico Ave, Denver, CO 80231</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-note {
    color: var(--color-ink-soft);
    margin-top: 1.25rem;
    max-width: 620px;
  }

  .field span {
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .bot-field {
    display: none;
  }

  .legal-disclosure {
    padding-top: 0;
  }

  .organization-notice {
    border-left: 3px solid var(--color-gold);
    max-width: 920px;
    padding: 1.25rem 1.5rem;
  }

  .organization-notice p {
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }

  .organization-notice h2 {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    margin: 1.5rem 0 0.8rem;
  }

  .organization-details {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .organization-details div {
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: 0.25rem;
    grid-template-columns: minmax(180px, 0.65fr) 1.35fr;
    padding: 0.7rem 0;
  }

  .organization-details dt {
    color: var(--color-ink);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .organization-details dd {
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 640px) {
    .organization-details div {
      grid-template-columns: 1fr;
    }
  }
</style>
