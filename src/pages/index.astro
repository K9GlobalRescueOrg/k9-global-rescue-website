---
import Layout from "../components/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProgramCard from "../components/ProgramCard.astro";
import CTASection from "../components/CTASection.astro";

const programs = [
  {
    title: "Korea & Asia",
    text: "Dog meat trade rescue, rehabilitation, transport, and advocacy.",
    href: "/korea-asia/"
  },
  {
    title: "Ukraine",
    text: "Humanitarian aid, animal medical support, supplies, and evacuations.",
    href: "/ukraine/"
  },
  {
    title: "Israel/Gaza",
    text: "Humanitarian animal rescue support, emergency coordination, and partner-led care.",
    href: "/operations/#israel-gaza"
  },
  {
    title: "Disaster Relief",
    text: "Emergency supplies, transport, partner coordination, and response support.",
    href: "/disaster-relief/"
  },
  {
    title: "Rescue Stories",
    text: "Rescue stories, project updates, and recovery journeys.",
    href: "/rescue-stories/"
  },
  {
    title: "Volunteer Network",
    text: "Volunteer interest, logistics support, field skills, and partner needs.",
    href: "/volunteer/"
  }
];

const actions = [
  ["Rescue Animals In Crisis", "Rapid support for dogs and animals facing urgent harm."],
  ["Support Global Partners", "Work with rescue groups, shelters, clinics, and field teams."],
  ["Move Aid And Medical Support", "Food, supplies, transport, veterinary care, and evacuation help."],
  ["Help Animals Reach Safety", "Recovery, rehabilitation, transport, and adoption support."]
];
---

<Layout
  title="K9 Global Rescue"
  description="K9 Global Rescue is a mission-driven nonprofit working globally for animals in crisis through rescue, relief, transport, medical care, and advocacy."
>
  <section class="belief-hero">
    <div class="container belief-hero__inner">
      <div class="belief-hero__copy">
        <p class="eyebrow">Core belief</p>
        <h1>“Saving one dog won’t change the world, but for that one dog the world will change forever.”<sup>™</sup></h1>
        <p class="lead">Every rescue begins with one life. Every safe transport, medical case, and partner mission starts there.</p>
        <div class="button-row">
          <a class="button primary" href="/donate/">Donate</a>
          <a class="button secondary" href="/volunteer/">Volunteer</a>
          <a class="button secondary" href="/operations/">Learn About Our Work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="values-strip" aria-label="K9 Global Rescue values">
    <div class="container">
      <p>Action · Compassion · Hope</p>
    </div>
  </section>

  <Hero
    eyebrow="United States 501(c)(3) nonprofit and EU registered NGO"
    title="Global Rescue For Animals In Crisis."
    text="K9 Global Rescue helps animals facing war, disaster, cruelty, and abandonment through rescue operations, aid, medical support, transport, and partner networks."
    primaryLabel="Donate"
    primaryHref="/donate/"
    secondaryLabel="Volunteer"
    secondaryHref="/volunteer/"
    tertiaryLabel="Learn About Our Work"
    tertiaryHref="/operations/"
    backgroundImage="/assets/operations-hero-k9gr-rescue.png"
    backgroundPosition="center"
    mobileBackgroundPosition="63% center"
  />

  <CTASection
    title="Give. Volunteer. Move Rescue Forward."
    text="Your next step should be simple: fund the work, join the volunteer network, or learn where K9GR operates."
    primaryLabel="Donate"
    primaryHref="/donate/"
    secondaryLabel="Volunteer"
    secondaryHref="/volunteer/"
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="What we do"
        title="Operational Help For Animals Without A Voice."
        text="Short, direct support for urgent rescue needs."
      />
      <div class="grid cards">
        {actions.map(([title, text]) => (
          <div class="panel text-panel action-card">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <SectionHeading
        eyebrow="Focus areas"
        title="Where The Work Happens."
        text="Choose a program area for rescue, relief, transport, advocacy, and support pathways."
      />
      <div class="grid cards">
        {programs.map((program) => <ProgramCard {...program} />)}
      </div>
    </div>
  </section>

  <CTASection
    title="Rescue Work Needs Fast Support."
    text="Donations help support rescue operations, medical care, food, shelter, transport, and emergency response."
    primaryLabel="Donate"
    primaryHref="/donate/"
    secondaryLabel="Learn About Our Work"
    secondaryHref="/operations/"
  />
</Layout>

<style>
  .belief-hero {
    position: relative;
    min-height: 650px;
    display: grid;
    align-items: end;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.97) 0%, rgba(0, 0, 0, 0.84) 46%, rgba(0, 0, 0, 0.58) 100%),
      linear-gradient(135deg, rgba(232, 180, 72, 0.18), transparent 36%),
      url("/assets/operations-hero-k9gr-rescue.png");
    background-position: center;
    background-size: cover;
    color: var(--color-ivory);
    isolation: isolate;
  }

  .belief-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(232, 180, 72, 0.09) 1px, transparent 1px),
      linear-gradient(rgba(232, 180, 72, 0.08) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: linear-gradient(90deg, #000 0%, transparent 72%);
  }

  .belief-hero::after {
    content: "K9";
    position: absolute;
    right: clamp(-2rem, 2vw, 4rem);
    bottom: -0.2em;
    z-index: -1;
    color: rgba(232, 180, 72, 0.08);
    font-size: clamp(13rem, 33vw, 30rem);
    font-weight: 950;
    line-height: 0.8;
    letter-spacing: 0;
  }

  .belief-hero__inner {
    padding: 104px 0 82px;
  }

  .belief-hero__copy {
    max-width: 1040px;
    border-left: 5px solid var(--color-gold);
    padding-left: clamp(1rem, 3vw, 2.5rem);
  }

  .belief-hero .eyebrow {
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .belief-hero h1 {
    max-width: 990px;
    font-size: clamp(2.65rem, 7vw, 6.25rem);
    letter-spacing: 0;
    line-height: 0.94;
    margin: 0;
    text-transform: none;
  }

  .belief-hero sup {
    color: var(--color-gold);
    font-size: 0.25em;
    line-height: 0;
    margin-left: 0.08em;
    vertical-align: super;
  }

  .belief-hero .lead {
    max-width: 720px;
    margin: 1.35rem 0 1.75rem;
    color: rgba(255, 255, 255, 0.86);
  }

  .values-strip {
    border-block: 1px solid rgba(232, 180, 72, 0.32);
    background: #000000;
    color: var(--color-gold);
    padding: 1rem 0;
  }

  .values-strip p {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 950;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .action-card {
    min-height: 0;
  }

  @media (max-width: 820px) {
    .belief-hero {
      min-height: 620px;
      background-position: 63% center;
    }

    .belief-hero__inner {
      padding: 90px 0 58px;
    }

    .belief-hero__copy {
      border-left-width: 4px;
    }
  }
</style>
