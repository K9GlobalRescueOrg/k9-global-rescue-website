---
import Layout from "../components/Layout.astro";
import { products, productAction, ornamentPacks, ornamentImages } from "../data/store";
const [ornaments, ...merch] = products;

---

<Layout title="Store" description="Explore K9 Global Rescue merchandise, featuring K9 Holiday Ornaments, shirts, mugs, and keychains.">
  <section class="store-intro container">
    <p class="eyebrow">K9 Global Rescue / Store</p>
    <h1>Give a gift that gives hope.</h1>
    <p class="lead">Gifts for your people. A voice for animals. Explore K9 Global Rescue merchandise, starting with our holiday ornaments.</p>
    <nav class="collection-nav" aria-label="Store collections">
      <a href="#holiday-ornaments">Holiday ornaments <span aria-hidden="true">↗</span></a>
      <a href="#merch">Shirts, mugs &amp; keychains <span aria-hidden="true">↓</span></a>
    </nav>
  </section>

  <section class="holiday-section" id="holiday-ornaments" aria-labelledby="holiday-title">
    <div class="container holiday-grid">
      <div class="ornament-gallery" aria-label="Ornament images">
        <a class="holiday-art" href={ornaments.image!} target="_blank" rel="noopener noreferrer" aria-label="View paired ornament image full size">
          <img class="product-photo" src={ornaments.image!} alt={ornaments.imageAlt} width="592" height="664" fetchpriority="high" />
        </a>
        <div class="detail-images">
          {ornamentImages.map((image) => <a href={image.src} target="_blank" rel="noopener noreferrer">
            <img src={image.src} alt={image.alt} width="1254" height="1254" loading="lazy" />
            <span>{image.label} <span aria-hidden="true">↗</span></span>
          </a>)}
        </div>
        <p class="gallery-note">Select an image to view it full size.</p>
      </div>
      <div class="holiday-copy">
        <p class="eyebrow">Limited edition</p>
        <h2 id="holiday-title">K9 Holiday<br />Ornaments</h2>
        <p>{ornaments.description}</p>
        <div class="pack-options" aria-label="Choose your ornament pack">
          {ornamentPacks.map((pack) => <a class="pack-option" href={pack.url} target="_blank" rel="noopener noreferrer" aria-label={`Buy ${pack.quantity} pack for ${pack.price} through Stripe`}>
            <span>{pack.quantity} Pack</span><strong>{pack.price}</strong><span class="pack-buy">Buy now ↗</span>
          </a>)}
        </div>
        <p class="purchase-note">Select a pack to order through Stripe. Check shipping availability and your final total at checkout.</p>
        <p class="mission-signoff">Action · Compassion · Hope</p>
      </div>
    </div>
  </section>

  <section class="section" id="merch" aria-labelledby="merch-title">
    <div class="container">
      <div class="collection-heading">
        <div><p class="eyebrow">Beyond the holidays</p><h2 id="merch-title">Everyday K9 gear.</h2></div>
        <p>Wear it. Use it. Take it with you.</p>
      </div>
      <div class="merch-grid">
        {merch.map((product, index) => {
          const action = productAction(product);
          return <article id={product.id} class="merch-item">
            {product.image && <img class="merch-photo" src={product.image} alt={product.imageAlt} loading="lazy" width="600" height="600" />}
            <div class="item-heading"><p class="eyebrow">{product.category}</p><span aria-hidden="true">0{index + 1}</span></div>
            <h3>{product.name}</h3>
            <p>{product.description}</p>
            {product.priceLabel && <p class="price">{product.priceLabel}</p>}
            <a class="product-link" href={action.href} target={action.external ? "_blank" : undefined} rel={action.external ? "noopener noreferrer" : undefined}>{action.label} <span aria-hidden="true">↗</span></a>
          </article>;
        })}
      </div>
    </div>
  </section>

  <section class="store-help" aria-labelledby="help-title">
    <div class="container help-inner">
      <div><p class="eyebrow">We’re here to help</p><h2 id="help-title">Questions about an item?</h2><p>For product options, sizes, quantities, or shipping questions, get in touch with the K9 Global Rescue team.</p></div>
      <a class="button secondary" href="/contact/">Contact us</a>
    </div>
  </section>
</Layout>

<style>
  .store-intro { padding-block: clamp(44px, 6vw, 76px) 36px; }
  .store-intro h1 { font-size: clamp(2.8rem, 6vw, 5rem); margin-bottom: 20px; }
  .store-intro .lead { max-width: 650px; }
  .collection-nav { display: flex; flex-wrap: wrap; gap: 16px 36px; margin-top: 28px; }
  .collection-nav a { display: inline-flex; align-items: center; gap: 20px; min-height: 44px; text-decoration: none; border-bottom: 1px solid var(--color-border); font-weight: 700; }
  .holiday-section { background: #0d0d09; padding-block: 36px 56px; scroll-margin-top: 140px; }
  .holiday-grid { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: clamp(28px, 5vw, 72px); }
  .holiday-art { min-height: 390px; display: grid; place-items: center; background: #000; border: 1px solid var(--color-border); }
  .product-photo { display: block; width: 100%; height: auto; max-height: 460px; object-fit: contain; background: #fff; }
  .holiday-art { background: #fff; }
  .detail-images { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
  .detail-images a { color: var(--color-ivory); text-decoration: none; font-size: .8rem; }
  .detail-images img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; background: #fff; }
  .detail-images a > span { display: block; padding-block: 10px 4px; }
  .gallery-note { font-size: .8rem; color: var(--color-ink-soft); margin: 8px 0 0; }
  .holiday-copy h2 { font-size: clamp(2.4rem, 4.4vw, 4rem); margin-bottom: 22px; }
  .holiday-copy > p:not(.eyebrow):not(.price) { color: var(--color-ink-soft); max-width: 460px; }
  .pack-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 24px; }
  .pack-option { display: grid; grid-template-columns: 1fr auto; gap: 6px; padding: 16px; background: #000; border: 1px solid var(--color-border); border-radius: var(--radius); text-decoration: none; color: var(--color-ivory); }
  .pack-option:hover { border-color: var(--color-gold); background: #18150d; }
  .pack-option strong { color: var(--color-gold); }
  .pack-buy { grid-column: 1 / -1; font-size: .82rem; color: var(--color-gold); font-weight: 750; }
  .mission-signoff { text-transform: uppercase; letter-spacing: .12em; font-weight: 750; font-size: .75rem; }
  .holiday-copy .purchase-note { font-size: .88rem; margin-top: 16px; }
  .collection-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 36px; }
  .collection-heading h2 { font-size: clamp(2rem, 3.5vw, 3rem); }
  .collection-heading > p { color: var(--color-ink-soft); margin: 0; }
  .merch-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; }
  .merch-item { border-top: 1px solid var(--color-gold); padding-top: 24px; display: flex; flex-direction: column; }
  .item-heading { display: flex; justify-content: space-between; gap: 12px; }
  .item-heading > span { color: var(--color-ink-soft); font-size: .8rem; }
  .merch-item h3 { font-size: 1.8rem; margin: 10px 0 18px; }
  .merch-item > p { color: var(--color-ink-soft); }
  .product-link { display: flex; gap: 16px; align-items: center; min-height: 48px; margin-top: auto; padding-top: 16px; font-weight: 750; text-underline-offset: 5px; }
  .merch-photo { width: 100%; aspect-ratio: 1; object-fit: contain; background: #000; margin-bottom: 24px; }
  .price { font-size: 1.25rem; font-weight: 800; color: var(--color-ivory); }
  .store-help { background: #0d0d09; border-top: 1px solid var(--color-border); padding-block: 44px; }
  .help-inner { display: flex; justify-content: space-between; align-items: center; gap: 32px; }
  .help-inner h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 16px; }
  .help-inner p:not(.eyebrow) { color: var(--color-ink-soft); max-width: 650px; margin-bottom: 0; }
  .help-inner .button { flex-shrink: 0; }
  a:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 5px; }
  #merch { scroll-margin-top: 100px; }
  @media (max-width: 760px) {
    .holiday-grid, .merch-grid { grid-template-columns: 1fr; }
    .holiday-art { min-height: 290px; }
    .product-photo { max-height: 390px; }
    .collection-heading, .help-inner { align-items: flex-start; flex-direction: column; }
    .merch-grid { gap: 36px; }
    .collection-nav { gap: 12px 24px; }
    .holiday-section { scroll-margin-top: 120px; }
  }
</style>
